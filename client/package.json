{
  "name": "forma-client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build && node scripts/build-metadata.mjs",
    "media": "node scripts/prepare-media.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/validate-browser.cjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "gsap": "^3.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "vite": "^6.0.1"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4"
  }
}
